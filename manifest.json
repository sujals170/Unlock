{
  "manifest_version": 3,
  "name": "Lock Remover",
  "version": "1.0",
  "description": "Remover",
  "publisher": "byte",
  "permissions": ["scripting", "tabs"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "48": "icon.png"
  }
}
